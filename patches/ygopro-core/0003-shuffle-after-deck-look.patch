+// Duel Circuit: an effect resolving showed its player cards in this Deck (or searched it and found nothing).
+void field::mark_deck_look(uint8_t playerid) {
+	if(playerid > 1 || !is_flag(DUEL_SHUFFLE_AFTER_DECK_LOOK) || core.shuffle_check_disabled || core.check_level == 0 || !core.reason_effect
+	   || pduel->lua->no_action)
+		return;
+	core.deck_look_check[playerid] = true;
+}
+// Duel Circuit: the resolving effect put cards on top of or under this Deck, worked with its top or bottom cards, or moved
+// its cards with the shuffle check disabled: keep the order. Only from the effect's own script, not from a filter, condition
+// or value function it calls (no_action), so a filter that reads the top card doesn't cancel a look.
+void field::mark_deck_order_kept(uint8_t playerid) {
+	if(playerid > 1 || !is_flag(DUEL_SHUFFLE_AFTER_DECK_LOOK) || core.check_level == 0 || !core.reason_effect || pduel->lua->no_action)
+		return;
+	core.deck_order_kept[playerid] = true;
 }
